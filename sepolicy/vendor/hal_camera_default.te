allow hal_camera_default public_adsprpcd_file:file r_file_perms;
allow hal_camera_default vendor_xdsp_device:chr_file r_file_perms;

# /proc/boost_pool/camera
allow hal_camera_default proc:file { write open getattr };

# Binder: HAL ↔ camera app
allow hal_camera_default opluscamera_app:binder { call transfer };
